+@pytest.mark.parametrize('latest', [False, True])
+def test_main_all_cached_skips_credentials_and_models(env, latest, capsys):
+    root, calls, run = env
+    _r2(root, 'partial')
+    path = _snapshot(root, {A: _record(A), B: _record(B)}, latest=latest)
+    before = path.read_bytes()
+    assert run() == 0
+    assert 'pending=0' in capsys.readouterr().out
+    assert path.read_bytes() == before
+    assert not calls['vision'] and not calls['render'] and not DOTENV_CALLS
