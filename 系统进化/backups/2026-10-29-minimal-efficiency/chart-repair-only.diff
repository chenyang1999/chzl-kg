+"""Bounded offline main/CLI regression; no credentials or production data.
+
+Run only this file with plugins/conftest disabled and scratch basetemp.
+External renderer/vision/dotenv are the only effect boundaries replaced.
+"""
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+import types
+
+APP = Path(__file__).resolve().parents[2]
+SCRATCH = Path('/Users/chenyang/.hermes/cache/scratch')
+VIOLATIONS = []
+
+
+def _audit(event, args):
+    if event in {'socket.connect', 'socket.bind', 'socket.getaddrinfo', 'subprocess.Popen', 'os.system'}:
+        VIOLATIONS.append(event)
+        raise RuntimeError('offline boundary: ' + event)
+    if event == 'open' and isinstance(args[0], (str, bytes, os.PathLike)):
+        p = Path(os.fsdecode(args[0])).absolute()
+        forbidden = (p.name == '.env' or p.name.startswith('.env.')
+                     or p.is_relative_to(APP / 'data') or p.is_relative_to(APP / 'chzl_kg')
+                     or any(s in p.parts for s in ('accounts', '.ssh', '.aws')))
+        mode, flags = args[1:3]
+        writing = (isinstance(mode, str) and any(c in mode for c in 'wax+')) or (isinstance(flags, int) and flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT))
+        if forbidden or (writing and not p.is_relative_to(SCRATCH) and str(p) != '/dev/null'):
+            VIOLATIONS.append(event + ':' + str(p))
+            raise RuntimeError('offline file boundary: ' + str(p))
+
+
+# Installed before importing any application module (collection, not fixture).
+sys.addaudithook(_audit)
+settings = types.ModuleType('src.settings')
+settings.__file__ = '<offline-settings>'
+sys.modules['src.settings'] = settings
+DOTENV_CALLS = []
+dotenv = types.ModuleType('dotenv')
+dotenv.__file__ = '<offline-dotenv>'
+dotenv.load_dotenv = lambda *a, **k: DOTENV_CALLS.append(str(a[0]))
+sys.modules['dotenv'] = dotenv
+sys.path.insert(0, str(APP))
+# research.__init__ eagerly imports the unrelated full orchestrator. Keep the
+# real candidate_pool and _collect_leaders modules, bypass package bootstrap only.
+research = types.ModuleType('src.research')
+research.__path__ = [str(APP / 'src/research')]
+research.__file__ = str(APP / 'src/research/__init__.py')
+sys.modules['src.research'] = research
+from src.research import candidate_pool as cp
+spec = importlib.util.spec_from_file_location('chart_snapshot_under_test', APP / 'scripts/fetch/run_chart_vision_snapshot.py')
+chart = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(chart)
+IMPORT_DOTENV_CALLS = list(DOTENV_CALLS)
+
+import pytest
+
+DATE = '20990105'
+A, B, C = '000001.SZ', '000002.SZ', '600001.SH'
+
+
+def _write(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value), encoding='utf-8')
+
+
+def _record(code, tag='cached'):
+    return {'ts_code': code, 'summary': tag, 'signals': [], 'error': None}
+
+
+@pytest.fixture
+def env(tmp_path, monkeypatch):
+    assert tmp_path.is_relative_to(SCRATCH)
+    monkeypatch.setattr(chart, 'ROOT', tmp_path)
+    monkeypatch.setattr(cp, 'ROOT', tmp_path)
+    for key in ('OPENAI_API_KEY', 'VISION_API_KEY', 'TUSHARE_TOKEN'):
+        monkeypatch.delenv(key, raising=False)
+    DOTENV_CALLS.clear()
+    calls = {'render': [], 'vision': []}
+    renderer = types.ModuleType('src.analytics.lwc_chart_renderer')
+    vision = types.ModuleType('src.agents.chart_vision_agent')
+    renderer.__file__ = vision.__file__ = '<offline-external-boundary>'
+
+    def render(code, **kwargs):
+        calls['render'].append(code)
+        path = tmp_path / (code + '.png')
+        path.write_bytes(b'synthetic image boundary, not a service result')
+        return {'path': str(path), 'fetch_ms': 0, 'render_ms': 0}
+
+    def analyze(**kwargs):
+        code = kwargs['ts_code']
+        calls['vision'].append(code)
+        return _record(code, 'synthetic boundary response')
+
+    renderer.render_lwc_multi_period_kline = render
+    vision.analyze_chart_vision = analyze
+    monkeypatch.setitem(sys.modules, renderer.__name__, renderer)
+    monkeypatch.setitem(sys.modules, vision.__name__, vision)
+
+    def run(*argv, key=False):
+        if key:
+            monkeypatch.setenv('VISION_API_KEY', 'synthetic-offline-only')
+        monkeypatch.setattr(sys, 'argv', ['run_chart_vision_snapshot.py', '--date', DATE, '--concurrency', '1', *map(str, argv)])
+        return chart.main()
+
+    yield tmp_path, calls, run
+    assert not VIOLATIONS
+
+
+def _r2(root, status='complete', codes=(A, B)):
+    _write(root / 'data/research' / DATE / 'R2_main_sectors.json', {
+        'status': status, 'main_lines': [{'name': 'synthetic', 'leaders': [{'ts_code': c, 'name': c} for c in codes]}]})
+
+
+def _snapshot(root, records, *, latest=False, date=DATE):
+    path = root / ('data/cache/chart_vision_latest.json' if latest else f'data/raw/{DATE}/chart_vision_snapshot.json')
+    _write(path, {'date': date, 'generated_at': 'synthetic', 'results': records})
+    return path
+
+
+@pytest.mark.parametrize('case', ['missing', 'partial_empty', 'complete_empty', 'malformed', 'invalid_json', 'failed', 'explicit_empty', 'force_empty'])
+def test_main_zero_candidates_zero_external_calls(env, case, capsys):
+    root, calls, run = env
+    args = []
+    if case.endswith('_empty') and case.split('_')[0] in ('partial', 'complete'):
+        _r2(root, case.split('_')[0], ())
+    elif case == 'malformed':
+        _write(root / 'data/research' / DATE / 'R2_main_sectors.json', [])
+    elif case == 'invalid_json':
+        p = root / 'data/research' / DATE / 'R2_main_sectors.json'
+        p.parent.mkdir(parents=True)
+        p.write_text('{')
+    elif case == 'failed':
+        _r2(root, 'failed')
+    elif case in ('explicit_empty', 'force_empty'):
+        _r2(root)
+        p = root / 'universe.json'
+        _write(p, [])
+        args = ['--universe', p] + (['--force'] if case == 'force_empty' else [])
+    assert run(*args) == 0
+    assert '零候选' in capsys.readouterr().out
+    assert calls == {'render': [], 'vision': []}
+    assert not DOTENV_CALLS
+    assert not (root / 'data/raw').exists()
+    assert not IMPORT_DOTENV_CALLS
+
+
+@pytest.mark.parametrize('status', ['complete', 'partial'])
+def test_main_real_r2_candidates_no_padding(env, status):
+    root, calls, run = env
+    _r2(root, status)
+    assert run(key=True) == 0
+    assert calls == {'render': [A, B], 'vision': [A, B]}
+    out = json.loads((root / f'data/raw/{DATE}/chart_vision_snapshot.json').read_text())
+    assert set(out['results']) == {A, B}
+    assert out['run']['requested'] == 2
+
