+def _category(title: str) -> str:
+    """先辨动作所属证券；发行人的股票代码不代表摘牌对象是股票。
+
+    仅排除明确债券生命周期动作，混合标题中的股票风险/监管风险仍优先保留。
+    无法辨明对象的退市标题保守留在风险桶，不能靠出现“转债”一词洗掉风险。
+    """
+    bond = r"(?:可转债|可转换(?:公司)?债券|公司债券|债券|中期票据|[\w\u4e00-\u9fff]{1,12}转债|[“\"「][^”\"」]+债[”\"」])"
+    lifecycle = r"(?:赎回|兑付|到期|摘牌|终止上市|终止交易)"
+    bond_action = bool(re.search(bond + r"[^，。；;]{0,50}" + lifecycle, title)
+                       or re.search(lifecycle + r"[^，。；;]{0,15}" + bond, title))
+    stock_risk = bool(re.search(r"(?:股票|本公司(?:将被|被|可能被))[^，。；;]{0,30}(?:终止上市|退市|摘牌|风险警示)", title)
+                      or re.search(r"(?:股票|退市|其他)风险警示|面值退市|退市整理|退市风险", title))
+    # Remove only explicitly attributed bond actions before the conservative
+    # generic-risk check. A separate stock delisting clause remains visible.
+    remainder = re.sub(bond + r"[^，。；;]{0,50}?" + lifecycle, "", title) if bond_action else title
+    generic_risk = any(k in remainder for k in ("终止上市", "退市", "风险警示"))
+    if stock_risk or generic_risk or ("摘牌" in title and not bond_action):
+        return "ST/退市"
+    if any(k in title for k in CATEGORY_RULES[1][1]):
+        return "监管/处罚/问询"
+    if bond_action:
+        return "债券/转债兑付/摘牌"
+    for name, keywords in CATEGORY_RULES[2:]:
+        if keywords and any(k in title for k in keywords):
+            return name
+    return "其他"
