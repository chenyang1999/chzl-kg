+            state = "invalid" if not valid_date or not valid_close else "unverified" if expected is None else "fresh" if observed == expected else "stale" if observed < expected else "future_or_incomplete"
+            item_reason = ("invalid_trade_date" if not valid_date else "close_missing_or_nonfinite" if not valid_close
