+def calendar_rows(start, end, closed=()):
+    current, last = datetime.strptime(start, '%Y%m%d'), datetime.strptime(end, '%Y%m%d')
+    rows = []
+    while current <= last:
+        day = current.strftime('%Y%m%d')
+        rows.append({'cal_date': day, 'is_open': int(current.weekday() < 5 and day not in closed)})
+        current += timedelta(days=1)
+    return rows
+
