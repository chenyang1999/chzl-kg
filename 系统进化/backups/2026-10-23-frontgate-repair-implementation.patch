+def _deliver(env, plan):
+    _write(env.canonical, plan)
+    md = env.root / f"chzl_kg/投研交易/盘前预案/{DATE}.md"
+    md.parent.mkdir(parents=True, exist_ok=True)
+    md.write_text("# synthetic contract\n" + "fixture only\n" * 6)
