+def pick_channel(stock: dict, td: str) -> str | None:
+    """仅保留明确的原始通道；技术位置与引擎旧价不构成通道选择。
+
+    当前逐票引擎只能表达一个通道。空、非法或相互冲突的原始规则
+    不能以默认MA50、第一条规则或MA10溢价代替决策端的明确选择。
+    td保留既有调用接口；选择阶段不读取技术库。
+    """
+    rules = stock.get("entry_rules")
+    if not isinstance(rules, list):
+        return None
+    channels = set()
+    for rule in rules:
+        if not isinstance(rule, dict):
+            return None
+        if rule.get("price_src") in ("engine", "tech_backfill"):
+            continue
+        channel = rule.get("type")
+        if channel not in ("trend_pullback_buy", "leader_breakout", "divergence_pullback"):
+            return None
+        channels.add(channel)
+    return next(iter(channels)) if len(channels) == 1 else None
 
 
