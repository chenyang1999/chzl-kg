+    legacy._write(env.root / f"data/health/research_pipeline_{DATE}.json",
+                  {"trade_date": DATE, "run_id": ""})
+    with pytest.raises(ValueError, match="research owner missing"):
+        env.ensure._selective_context(DATE, plan)
