+@pytest.mark.parametrize("code", ["000001.SZ", "300001.SZ", "920001.BJ"])
+def test_distance_diagnostic_does_not_certify_exchange_price_band(env, monkeypatch, code):
+    monkeypatch.setattr(env.levels, "load_tech", lambda *a: {"close": 100., "ma50": 85.})
+    rule = {"type": "trend_pullback_buy"}
+    stock = fixture_stock(ts_code=code, entry_rules=[deepcopy(rule)])
+    rows = env.apply.apply_to_plan(fixture_plan(stock), DATE)
+    row = rows[0]
+    # Preserve the existing conservative distance result, not a new price-band
+    # threshold. A heuristic must not claim the exchange proved impossibility.
+    assert row["ok"] is False and "unreachable_buy_zone" in row["reason"]
+    assert row["reachability_status"] == "unverified"
+    assert row["reference_gap_pct"] == round((row["buy_zone"][1] / 100 - 1) * 100, 1)
+    assert "当日边界未核" in stock["engine_levels"]["reason"]
+    assert row["trigger_price"] is None and row["risk_reward_ratio"] is None
+    assert stock["entry_rules"] == [rule] and stock["buy_eligibility"]["status"] == "unknown"
+
+
+@pytest.mark.parametrize("ma50", [None, 0., -1., float("nan"), float("inf"), True])
+def test_explicit_ma50_channel_never_fabricates_its_missing_line(env, monkeypatch, ma50):
+    monkeypatch.setattr(env.levels, "load_tech", lambda *a: {"close": 100., "ma50": ma50})
+    rule = {"type": "trend_pullback_buy"}
+    stock = fixture_stock(entry_rules=[deepcopy(rule)])
+    row = env.apply.apply_to_plan(fixture_plan(stock), DATE)[0]
+    assert row["ok"] is False and row["missing_inputs"] == ["ma50"]
+    assert row["channel"] == "trend_pullback_buy" and "未用昨收代替" in row["reason"]
+    assert row["trigger_price"] is None and row["risk_reward_ratio"] is None
+    assert stock["entry_rules"] == [rule] and stock["buy_eligibility"]["status"] == "unknown"
