+Path(args[args.index('--usage-file')+1]).write_text(json.dumps(usage))
+''');worker.chmod(0o700)
+    text=(n.root/'scripts/research/run_research_shell.sh').read_text()
+    state_function=next(line for line in text.splitlines() if line.startswith('state() {'))
+    start=text.index('run_agent() {');end=text.index('\n}',start)+2
+    script=n.root/'normal-stage.sh'
