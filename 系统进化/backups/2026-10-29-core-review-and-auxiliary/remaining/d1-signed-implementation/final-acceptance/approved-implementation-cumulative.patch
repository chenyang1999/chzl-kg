+        '\nrun_agent D1 main_decision_v1 "$ROOT/data/plans/$TRADE_DATE/watchlist_plan.json" synthetic canghai-plan\n')
+    env={**os.environ,'ROOT':str(n.root),'TRADE_DATE':DATE,'LOG_DIR':str(logs),
