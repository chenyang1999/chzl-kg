+def _emotion_baseline(trade_date: str) -> dict[str, Any]:
+    """Find actual matching metrics, never infer a close from its directory.
+
+    A later premarket artifact may carry valid T-1 metrics. Preserve its source
+    flags; no regeneration or live-history substitution is performed here.
+    """
+    found: list[tuple[int, str, dict[str, Any]]] = []
+    rejected: list[dict[str, Any]] = []
+    research = ROOT / "data" / "research"
+    cutoff = now()
+    for directory in sorted(research.glob("[0-9]" * 8)):
+        if directory.name < trade_date or directory.name > cutoff.strftime("%Y%m%d"):
+            continue
+        for filename in ("emotion_cycle_closed.json", "emotion_cycle.json"):
+            path = directory / filename
+            if not path.is_file():
+                continue
+            try:
+                payload = json.loads(path.read_text(encoding="utf-8"))
+                metrics = payload.get("metrics") or {}
+                metrics_date = metrics.get("metrics_date")
+                stamp = quote_time(payload.get("generated_at"))
+                if stamp is not None and stamp.replace(tzinfo=stamp.tzinfo or TZ) > cutoff:
+                    continue
+                if metrics_date != trade_date:
+                    if directory.name == trade_date:
+                        rejected.append({"path": str(path.relative_to(ROOT)), "metrics_date": metrics_date})
+                    continue
+                if metrics.get("_data_complete") is False or payload.get("degraded") is True:
+                    rejected.append({"path": str(path.relative_to(ROOT)), "reason": "degraded"})
+                    continue
+                if not payload.get("phase"):
+                    continue
+                score = int(payload.get("_is_closed") is True)
+                found.append((score, str(path.relative_to(ROOT)), payload))
+            except (OSError, ValueError, TypeError, AttributeError):
+                rejected.append({"path": str(path.relative_to(ROOT)), "reason": "invalid_json_or_schema"})
+    if not found:
+        return {"emotion_phase": None, "emotion_metrics_date": None,
+                "emotion_status": "missing_matching_metrics", "emotion_rejected": rejected}
+    best_score = max(x[0] for x in found)
