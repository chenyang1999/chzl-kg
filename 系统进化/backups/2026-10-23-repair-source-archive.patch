+def guard(event, args):
+    if SANDBOX is None:
+        return
+    if event in {"socket.connect", "socket.bind", "subprocess.Popen", "os.system", "sqlite3.connect"}:
+        VIOLATIONS.append(event)
+        raise AssertionError("forbidden external boundary: " + event)
+    if event == "open":
+        path, mode, flags = args
+        if not isinstance(path, (str, bytes, os.PathLike)):
+            return
+        resolved = Path(os.fsdecode(path)).resolve()
+        writing = (isinstance(mode, str) and any(c in mode for c in "wax+")) or (
+            isinstance(flags, int) and flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC))
+        if writing and not resolved.is_relative_to(SANDBOX):
+            VIOLATIONS.append("write:" + str(resolved))
+            raise AssertionError("write outside synthetic root")
+        if not writing:
+            READS.append(str(resolved))
+            private = (resolved.is_relative_to(REPO / "data") or resolved.is_relative_to(REPO / "chzl_kg")
+                       or resolved.is_relative_to(Path.home() / ".hermes") or resolved.name == ".env"
+                       or "account" in resolved.name.lower() or "credential" in resolved.name.lower())
+            if private and not resolved.is_relative_to(SANDBOX):
+                VIOLATIONS.append("read:" + str(resolved))
+                raise AssertionError("real data/account/credential read forbidden")
+    if event == "os.mkdir":
+        target = Path(os.fsdecode(args[0])).resolve()
+        if not target.is_relative_to(SANDBOX):
+            VIOLATIONS.append("mkdir:" + str(target))
+            raise AssertionError("mkdir outside synthetic root")
+
+
+sys.addaudithook(guard)
