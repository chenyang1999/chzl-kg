+def _finite_number(value: Any, *, positive: bool = False) -> float | None:
+    """Missing/invalid is not zero; retain genuine numeric zero."""
+    if value is None or isinstance(value, bool):
+        return None
+    try:
+        number = float(value)
+    except (TypeError, ValueError, OverflowError):
+        return None
+    return number if math.isfinite(number) and (not positive or number > 0) else None
+
+
+def _json_safe(value: Any, missing: list[str] | None = None, path: str = "$") -> Any:
+    """Sanitize the entire tree, including raw provider/numpy values."""
+    if isinstance(value, dict):
+        return {k: _json_safe(v, missing, f"{path}.{k}") for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_json_safe(v, missing, f"{path}[{i}]") for i, v in enumerate(value)]
+    if isinstance(value, Number) and not isinstance(value, bool):
+        if _finite_number(value) is None:
+            if missing is not None:
+                missing.append(path)
+            return None
+        item = getattr(value, "item", None)
+        return item() if callable(item) else value
+    if isinstance(value, str) and value.strip().lower() in {"nan", "inf", "+inf", "-inf", "infinity", "+infinity", "-infinity"}:
+        if missing is not None:
+            missing.append(path)
+        return None
+    return value
+
+
+def _first_number(row: dict, *keys: str, positive: bool = False) -> float | None:
+    # A present invalid/zero field must not silently become another alias.
+    for key in keys:
+        if key in row and row[key] is not None:
+            return _finite_number(row[key], positive=positive)
+    return None
+
+
+def _premium(price: Any, close: Any) -> float | None:
+    price = _finite_number(price, positive=True)
+    close = _finite_number(close, positive=True)
+    return _finite_number(round(price / close - 1, 6)) if price is not None and close is not None else None
+
+
+def _finalize_snapshot(snapshot: dict[str, Any]) -> dict[str, Any]:
+    nonfinite: list[str] = []
+    snapshot = _json_safe(snapshot, nonfinite)
+    pool = snapshot.get("pool_auction") or []
+    missing = []
+    def null_paths(value, path="$"):
+        if isinstance(value, dict):
+            for key, child in value.items():
+                null_paths(child, f"{path}.{key}")
+        elif isinstance(value, list):
+            for i, child in enumerate(value):
+                null_paths(child, f"{path}[{i}]")
+        elif value is None:
+            missing.append(path)
+    # Empty/unrequested basket groups legitimately have null aggregates; those
+    # are not missing source fields. Inspect only actually requested inputs.
+    null_paths(pool, "$.pool_auction")
+    null_paths(snapshot.get("market_sentiment") or {}, "$.market_sentiment")
+    valid = 0
+    for i, row in enumerate(pool):
+        # Also repair legacy/provider zero-price placeholders at this boundary.
+        row["auction_price"] = _finite_number(row.get("auction_price"), positive=True)
+        row["prev_close"] = _finite_number(row.get("prev_close"), positive=True)
+        row["premium_pct"] = _premium(row["auction_price"], row["prev_close"])
+        row_missing = [k for k in ("auction_price", "prev_close", "premium_pct", "auction_volume", "auction_amount") if row.get(k) is None]
+        row["quality"] = {"status": "partial" if row_missing else "ok", "missing_fields": row_missing}
+        missing.extend(f"$.pool_auction[{i}].{k}" for k in row_missing)
+        valid += row["premium_pct"] is not None
+    sentiment = snapshot.get("market_sentiment") or {}
+    sentiment_values = {k: v for k, v in sentiment.items() if not k.endswith("_reason")}
+    missing.extend(f"$.market_sentiment.{k}" for k, v in sentiment_values.items() if v is None)
+    if not sentiment:
+        missing.append("$.market_sentiment")
+    usable_sentiment = any(isinstance(v, Number) for v in sentiment_values.values())
+    quality = {"requested_count": len(pool), "valid_count": valid, "missing_count": len(pool) - valid,
+               "coverage_ratio": valid / len(pool) if pool else None,
+               "nonfinite_fields": nonfinite, "missing_fields": sorted(set(missing)),
+               "pool_status": "ok" if valid == len(pool) and pool else "partial" if valid else "missing",
+               "sentiment_status": "partial" if any(v is None for v in sentiment_values.values()) else "ok" if usable_sentiment else "missing"}
+    snapshot["quality"] = quality
+    if snapshot.get("status") == "ok" and (missing or nonfinite):
