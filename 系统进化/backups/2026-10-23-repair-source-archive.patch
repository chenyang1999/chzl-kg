+CST = ZoneInfo("Asia/Shanghai")
+MARKETS = {"US": ("America/New_York", time(9, 30), time(16)),
+           "HK": ("Asia/Hong_Kong", time(9, 30), time(16, 10))}
+
+
+def _asof(date: str, now: datetime | None = None) -> datetime:
+    if not isinstance(date, str) or len(date) != 8 or not date.isdigit():
+        raise ValueError("date must be YYYYMMDD")
+    now = now or datetime.now(CST)
+    if now.tzinfo is None:
+        raise ValueError("asof requires a timezone-aware clock")
+    day = datetime.strptime(date, "%Y%m%d").date()
+    if day > now.astimezone(CST).date():
+        raise ValueError("future snapshot date is not allowed")
+    # A historical rerun cannot query/validate against today's completed day.
+    return min(now, datetime.combine(day, time.max, CST))
+
+
+def _expected_session(market: str, asof: datetime, rows: list[dict]) -> tuple[str | None, str]:
+    """Use this market's daily calendar, never SSE or a weekday approximation.
+
+    us_tradecal/hk_tradecal do not expose special-session closing times. During
+    an open session freshness is deliberately unverified; do not certify the
+    previous close as latest on an early-close day. Outside that window the
+    normal closing cutoff is a conservative upper bound.
+    """
+    if market not in MARKETS:
+        return None, "market_calendar_unavailable"
+    tz, opening, closing = MARKETS[market]
+    local = asof.astimezone(ZoneInfo(tz))
+    calendar: dict[str, int] = {}
+    try:
+        for row in rows:
+            day = str(row["cal_date"])
+            datetime.strptime(day, "%Y%m%d")
+            if str(row["is_open"]) not in {"0", "1"}:
+                raise ValueError("invalid is_open")
+            flag = int(row["is_open"])
+            if day in calendar and calendar[day] != flag:
+                raise ValueError("conflicting calendar rows")
+            calendar[day] = flag
+    except (KeyError, TypeError, ValueError):
+        return None, "invalid_market_calendar"
+    day = local.date()
+    key = day.strftime("%Y%m%d")
+    if key not in calendar:
+        return None, "market_calendar_coverage_missing"
+    if calendar[key] and opening <= local.time() < closing:
+        return None, "intraday_completion_unverified_calendar_has_no_special_close_times"
+    if calendar[key] and local.time() >= closing:
+        return key, "market_calendar_completed_close"
+    for offset in range(1, 46):
+        key = (day - timedelta(days=offset)).strftime("%Y%m%d")
+        if key not in calendar:
+            return None, "market_calendar_coverage_missing"
+        if calendar[key]:
+            return key, "market_calendar_completed_close"
+    return None, "no_completed_session_in_calendar_window"
+
+
