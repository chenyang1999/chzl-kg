+        day = asof.astimezone(ZoneInfo(MARKETS[market][0])).date()
+        try:
+            df = getattr(pro, method)(start_date=(day - timedelta(days=45)).strftime("%Y%m%d"), end_date=day.strftime("%Y%m%d"))
+            calendars[market] = df.to_dict("records") if df is not None else []
+        except Exception:
+            calendars[market] = []
+    return calendars
