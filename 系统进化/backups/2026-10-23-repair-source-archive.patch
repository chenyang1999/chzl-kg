+#!/usr/bin/env python3
+"""Live read-only Tushare probe; credentials only from the process environment.
+
+Example: .venv/bin/python -B scripts/health/probe_northbound.py --date 20261023
+No .env/config loading, trading calls, or production data writes.
+Raw field availability does not certify net-flow semantics.
+"""
+from __future__ import annotations
+
+import argparse
+from datetime import datetime, timedelta
+from decimal import Decimal, InvalidOperation
+import json
+import os
+from pathlib import Path
+import sys
+import time
+from zoneinfo import ZoneInfo
+
+import tushare as ts
+
+
+def probe(pro, label: str, api: str, arguments: dict) -> dict:
+    started = time.monotonic()
+    result = {"label": label, "api": api, "arguments": arguments,
+              "requested_at": datetime.now(ZoneInfo("Asia/Shanghai")).isoformat()}
+    try:
+        frame = pro.query(api, **arguments)
+        if frame is None:
+            raise ValueError("provider returned None, not a table")
+        rows = json.loads(frame.to_json(orient="records"))
+        result.update(status="ok" if rows else "empty", row_count=len(rows),
+                      fields=list(frame.columns), rows=rows)
+        if api == "moneyflow_hsgt":
+            dates = sorted(str(row.get("trade_date")) for row in rows if row.get("trade_date"))
+            result["latest_data_date"] = dates[-1] if dates else None
+            result["north_money_interpretation"] = "raw field only; not certified net purchases"
+            latest = max(rows, key=lambda r: str(r.get("trade_date", "")), default=None)
+            if latest:
+                try:
+                    number = Decimal(str(latest.get("north_money")))
+                    result["latest_north_money_raw"] = str(number) if number.is_finite() else None
+                    result["latest_north_money_yi_if_CNY_million"] = str(number / Decimal(100)) if number.is_finite() else None
+                except InvalidOperation:
+                    result["latest_north_money_raw"] = None
+    except Exception as exc:
+        # Do not print exception text: SDK errors can include URLs/credentials.
+        result.update(status="error", error_type=type(exc).__name__,
+                      error="Request failed; details suppressed to protect credentials")
+    result["elapsed_seconds"] = round(time.monotonic() - started, 3)
+    return result
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--date", default=datetime.now(ZoneInfo("Asia/Shanghai")).strftime("%Y%m%d"))
+    ap.add_argument("--output", type=Path, help="Optional new evidence file; existing files are never overwritten")
+    args = ap.parse_args()
+    if len(args.date) != 8 or not args.date.isascii() or not args.date.isdigit():
+        ap.error("--date must be exactly YYYYMMDD")
+    try:
+        target = datetime.strptime(args.date, "%Y%m%d")
+    except ValueError:
+        ap.error("invalid calendar date")
+    token = os.environ.get("TUSHARE_TOKEN")
+    if not token:
+        print(json.dumps({"status": "blocked", "reason": "TUSHARE_TOKEN absent from process environment; no credential files read"}))
+        return 2
+    pro = ts.pro_api(token, timeout=20)
+    calendar = probe(pro, "trading_calendar", "trade_cal", {
+        "exchange": "SSE", "start_date": (target - timedelta(days=14)).strftime("%Y%m%d"), "end_date": args.date})
+    closed_dates = sorted(str(row["cal_date"]) for row in calendar.get("rows", [])
+                          if str(row.get("is_open")) == "1" and str(row.get("cal_date", "")) < args.date)
+    calls = [calendar]
+    if closed_dates:
+        calls.append(probe(pro, "previous_completed_trading_day", "moneyflow_hsgt", {"trade_date": closed_dates[-1]}))
+    calls.extend([
+        probe(pro, "recent_range", "moneyflow_hsgt", {
+            "start_date": (target - timedelta(days=14)).strftime("%Y%m%d"), "end_date": args.date}),
+        probe(pro, "today", "moneyflow_hsgt", {"trade_date": args.date}),
+        probe(pro, "historical_disclosure_boundary", "moneyflow_hsgt", {"start_date": "20240812", "end_date": "20240823"}),
+    ])
+    payload = {"checked_at": datetime.now(ZoneInfo("Asia/Shanghai")).isoformat(),
+               "requested_date": args.date, "transport": "tushare_python_sdk",
+               "tushare_version": getattr(ts, "__version__", None),
+               "credential_source": "existing process environment; value never logged",
+               "net_flow_semantics_verified": False, "results": calls}
+    text = json.dumps(payload, ensure_ascii=False, indent=2, allow_nan=False) + "\n"
+    if args.output:
+        resolved = args.output.expanduser().resolve()
+        # Diagnostics stay out of live raw/research/plans/execution directories.
+        allowed = [Path.home() / ".hermes/cache/scratch",
+                   Path(__file__).resolve().parents[2] / "chzl_kg/系统进化/backups"]
+        if not any(resolved.is_relative_to(base.resolve()) for base in allowed):
+            ap.error("--output must be under Hermes scratch or system-evolution backups")
+        resolved.parent.mkdir(parents=True, exist_ok=True)
+        with resolved.open("x", encoding="utf-8") as handle:
+            handle.write(text)
+    print(text)
+    return 1 if any(call["status"] == "error" for call in calls) else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
