+        path = directory/(key+'.json')
+        path.write_text(json.dumps(obj, allow_nan=False))
+        if key not in omit:
+            args += ['--'+key, str(path)]
+    if 'quote_max_age' not in omit:
+        args += ['--quote-max-age','5']
+    args += list(extra)
