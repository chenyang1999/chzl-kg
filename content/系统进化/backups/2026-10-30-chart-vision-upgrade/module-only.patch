+    kwargs = {}
+    if change == 'model': monkeypatch.setenv('CHART_VISION_MODEL','synthetic-other-model')
+    elif change == 'prompt': monkeypatch.setattr(app.vision,'VISION_PROMPT',app.vision.VISION_PROMPT+'\nnew fixture prompt')
